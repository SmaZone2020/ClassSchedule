{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClassScheduleWidget",
  "version": "0.1.0",
  "identifier": "com.classschedule.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "url": "index.html",
        "title": "课表",
        "width": 620,
        "height": 420,
        "minWidth": 220,
        "minHeight": 160,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "alwaysOnTop": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
